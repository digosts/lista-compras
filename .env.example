# String de conexão do MongoDB.
# Local:  mongodb://127.0.0.1:27017/lista-compras
# Atlas:  mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/lista-compras?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lista-compras

# Fuso usado para exibir data e hora das compras (padrão: America/Sao_Paulo).
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
